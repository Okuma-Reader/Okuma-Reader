---
interface Props {
  href: string;
  color: string;
  disabled: boolean;
  download?: string | boolean;
}

const { color, href, disabled, download } = Astro.props;
const downloadAttr =
  download === true ? "" : typeof download === "string" ? download : undefined;
---

<a
  href={disabled ? undefined : href}
  download={downloadAttr}
  style={`--color: ${color}`}
  aria-disabled={disabled}><slot /></a
>

<style>
  a {
    color: var(--color);
    background-color: white;
    outline-width: 3px;
    outline-offset: -3px;
    outline-color: var(--color);
    outline-style: solid;
    text-decoration: none;
    font-size: 130%;
    font-weight: 600;
    padding: 0.5em 1em;
    display: inline-flex;
    align-items: center;
    gap: 0.35em;

    transition-duration: 75ms;
    transition-property: color, background-color;

    &:hover,
    &:focus-within {
      background-color: var(--color);
      color: white;
    }

    &[aria-disabled="true"] {
      color: var(--color);
      background-color: white;
      cursor: not-allowed;
    }
  }
</style>
