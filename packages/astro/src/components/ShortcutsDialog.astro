---
import Icon from "./Icon.astro";
import keyArrowLeft from "@okuma-reader/core/assets/keyboard/keyboard_arrow_left_outline.svg?url";
import keyArrowRight from "@okuma-reader/core/assets/keyboard/keyboard_arrow_right_outline.svg?url";
import keyPageUp from "@okuma-reader/core/assets/keyboard/keyboard_page_up_outline.svg?url";
import keyPageDown from "@okuma-reader/core/assets/keyboard/keyboard_page_down_outline.svg?url";
import keyCtrl from "@okuma-reader/core/assets/keyboard/keyboard_ctrl_outline.svg?url";
import keyEscape from "@okuma-reader/core/assets/keyboard/keyboard_escape_outline.svg?url";
import keyF from "@okuma-reader/core/assets/keyboard/keyboard_f_outline.svg?url";
import keyQuestion from "@okuma-reader/core/assets/keyboard/keyboard_question_outline.svg?url";
import mouseScrollUp from "@okuma-reader/core/assets/keyboard/mouse_scroll_up_outline.svg?url";
import mouseScrollDown from "@okuma-reader/core/assets/keyboard/mouse_scroll_down_outline.svg?url";
import mouseScrollVertical from "@okuma-reader/core/assets/keyboard/mouse_scroll_vertical_outline.svg?url";

const key = (url: string) => `--key: url(${JSON.stringify(url)})`;
---

<dialog id="shortcuts-dialog" aria-labelledby="shortcuts-title">
  <div class="shortcuts-panel">
    <div class="shortcuts-header">
      <h2 id="shortcuts-title">Keyboard shortcuts</h2>
      <button
        type="button"
        data-shortcuts-close
        aria-label="Close"
        class="icon-button"
      >
        <Icon name="close" />
      </button>
    </div>

    <section class="shortcuts-group">
      <h3>Navigation</h3>
      <table class="shortcuts-table">
        <tbody>
          <tr>
            <th scope="row" aria-label="Left arrow, Page Up, or scroll up">
              <span class="shortcut-keys" aria-hidden="true">
                <span
                  class="shortcut-key"
                  style={key(keyArrowLeft)}
                ></span>
                <span class="or">or</span>
                <span
                  class="shortcut-key"
                  style={key(keyPageUp)}
                ></span>
                <span class="or">or</span>
                <span
                  class="shortcut-key"
                  style={key(mouseScrollUp)}
                ></span>
              </span>
            </th>
            <td>Previous pages</td>
          </tr>
          <tr>
            <th scope="row" aria-label="Right arrow, Page Down, or scroll down">
              <span class="shortcut-keys" aria-hidden="true">
                <span
                  class="shortcut-key"
                  style={key(keyArrowRight)}
                ></span>
                <span class="or">or</span>
                <span
                  class="shortcut-key"
                  style={key(keyPageDown)}
                ></span>
                <span class="or">or</span>
                <span
                  class="shortcut-key"
                  style={key(mouseScrollDown)}
                ></span>
              </span>
            </th>
            <td>Next pages</td>
          </tr>
          <tr>
            <th scope="row" aria-label="Control plus Left arrow">
              <span class="shortcut-keys" aria-hidden="true">
                <span
                  class="shortcut-key"
                  style={key(keyCtrl)}
                ></span>
                <span class="plus">+</span>
                <span
                  class="shortcut-key"
                  style={key(keyArrowLeft)}
                ></span>
              </span>
            </th>
            <td>Previous chapter</td>
          </tr>
          <tr>
            <th scope="row" aria-label="Control plus Right arrow">
              <span class="shortcut-keys" aria-hidden="true">
                <span
                  class="shortcut-key"
                  style={key(keyCtrl)}
                ></span>
                <span class="plus">+</span>
                <span
                  class="shortcut-key"
                  style={key(keyArrowRight)}
                ></span>
              </span>
            </th>
            <td>Next chapter</td>
          </tr>
        </tbody>
      </table>
    </section>

    <section class="shortcuts-group">
      <h3>Fullscreen</h3>
      <table class="shortcuts-table">
        <tbody>
          <tr>
            <th scope="row" aria-label="F">
              <span class="shortcut-keys" aria-hidden="true">
                <span
                  class="shortcut-key"
                  style={key(keyF)}
                ></span>
              </span>
            </th>
            <td>Toggle fullscreen</td>
          </tr>
          <tr>
            <th scope="row" aria-label="Escape">
              <span class="shortcut-keys" aria-hidden="true">
                <span
                  class="shortcut-key"
                  style={key(keyEscape)}
                ></span>
              </span>
            </th>
            <td>Exit fullscreen</td>
          </tr>
        </tbody>
      </table>
    </section>

    <section class="shortcuts-group">
      <h3>Others</h3>
      <table class="shortcuts-table">
        <tbody>
          <tr>
            <th scope="row" aria-label="Control plus scroll">
              <span class="shortcut-keys" aria-hidden="true">
                <span
                  class="shortcut-key"
                  style={key(keyCtrl)}
                ></span>
                <span class="plus">+</span>
                <span
                  class="shortcut-key"
                  style={key(mouseScrollVertical)}
                ></span>
              </span>
            </th>
            <td>Zoom</td>
          </tr>
          <tr>
            <th scope="row" aria-label="Control plus F">
              <span class="shortcut-keys" aria-hidden="true">
                <span
                  class="shortcut-key"
                  style={key(keyCtrl)}
                ></span>
                <span class="plus">+</span>
                <span
                  class="shortcut-key"
                  style={key(keyF)}
                ></span>
              </span>
            </th>
            <td>Find in book</td>
          </tr>
          <tr>
            <th scope="row" aria-label="Question mark">
              <span class="shortcut-keys" aria-hidden="true">
                <span
                  class="shortcut-key"
                  style={key(keyQuestion)}
                ></span>
              </span>
            </th>
            <td>Keyboard shortcuts</td>
          </tr>
        </tbody>
      </table>
    </section>

    <p class="shortcuts-note">On a Mac, ⌘ works in place of Ctrl.</p>
  </div>
</dialog>

<style>
  #shortcuts-dialog {
    padding: 0;
    border: none;
    background: transparent;
    max-width: calc(100vw - 2rem);
    box-shadow: 0 0 5em var(--dark-color);
  }

  #shortcuts-dialog::backdrop {
    background: color-mix(in srgb, var(--dark-color) 50%, transparent);
    backdrop-filter: blur(2px);
  }

  .shortcuts-panel {
    --shortcuts-ink: #000;
    --key-size: 2.5rem;
    box-sizing: border-box;
    width: min(42rem, 100%);
    padding: 1em;
    border: 3px solid var(--dark-color);
    background: white;
    color: var(--shortcuts-ink);
  }

  .shortcuts-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .shortcuts-header h2 {
    margin: 0;
    flex: 1;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--dark-color);
  }

  .shortcuts-group {
    margin-block: 1.5rem;
    margin-inline: 2em;
  }

  .shortcuts-group h3 {
    margin: 0 0 0.35rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    opacity: 0.8;
    color: var(--dark-color);
  }

  .shortcuts-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 1rem;
  }

  .shortcuts-table th,
  .shortcuts-table td {
    padding: 0.4rem 0;
    vertical-align: middle;
    font-weight: 500;
  }

  .shortcuts-table th {
    padding-right: 1.25rem;
    text-align: left;
    font-weight: 600;
    white-space: nowrap;
  }

  .shortcuts-table td {
    width: 100%;
  }

  .shortcut-keys {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
  }

  .shortcut-key {
    display: inline-block;
    width: var(--key-size);
    height: var(--key-size);
    background-color: var(--shortcuts-ink);
    -webkit-mask: var(--key) center / contain no-repeat;
    mask: var(--key) center / contain no-repeat;
  }

  .shortcuts-table .or,
  .shortcuts-table .plus {
    margin: 0 0.2em;
    font-weight: 500;
    opacity: 0.7;
  }

  .shortcuts-note {
    margin: 1rem 0 0;
    font-size: 0.9rem;
    font-weight: 500;
    opacity: 0.75;
  }

  .icon-button {
    box-sizing: border-box;
    width: 42px;
    height: 42px;
    border: 3px solid var(--dark-color);
    background: white;
    color: var(--dark-color);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;

    & :global(svg) {
      width: 28px;
      height: 28px;
    }

    &:disabled {
      cursor: not-allowed;
    }

    &:hover:not(:disabled),
    &:focus-visible:not(:disabled),
    &[aria-expanded="true"]:not(:disabled) {
      background: var(--dark-color);
      color: white;
    }
  }
</style>
