---
import Icon from "./Icon.astro";
import ReaderPage from "./ReaderPage.astro";
import SearchBar from "./SearchBar.astro";
---

<div id="spread-area">
  <button
    type="button"
    id="fullscreen-exit"
    class="icon-button"
    aria-label="Exit fullscreen"
    title="Exit fullscreen"
    aria-expanded="true"
    hidden
  >
    <Icon name="fullscreen_exit" />
  </button>
  <button
    type="button"
    class="icon-button"
    id="turn-prev"
    data-turn="prev"
    aria-label="Previous pages"
  >
    <Icon name="chevron_left" />
  </button>
  <div id="spread">
    <div id="spread-stage">
      <div id="book-zoom-shell">
        <div
          id="book"
          data-closed="true"
          data-cover="front"
          data-zoomed="false"
        >
          <span id="book-hardcover" aria-hidden="true">
            <span class="book-hardcover-specular"></span>
          </span>
          <ReaderPage side="left" />
          <ReaderPage side="right" />
        </div>
      </div>
    </div>
  </div>
  <button
    type="button"
    class="icon-button"
    id="turn-next"
    data-turn="next"
    aria-label="Next pages"
  >
    <Icon name="chevron_right" />
  </button>
  <SearchBar />
</div>
