---
interface Props {
  href: string;
  color: string;
  primary?: boolean;
  disabled?: boolean;
  download?: string | boolean;
}

const {
  href,
  color,
  primary = false,
  disabled = false,
  download,
} = Astro.props;

const downloadAttr =
  download === true ? "" : typeof download === "string" ? download : undefined;
---

<a
  href={disabled ? undefined : href}
  download={downloadAttr}
  class={primary ? "okuma-btn-primary" : "okuma-btn-secondary"}
  style={`--color: ${color}`}
  aria-disabled={disabled}><slot /></a
>
