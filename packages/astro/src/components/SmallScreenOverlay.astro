---
import Button from "./Button.astro";
import Icon from "./Icon.astro";
import type { OkumaDownloadConfig } from "../types";

interface Props {
  backHref?: string;
  accentColor: string;
  download?: OkumaDownloadConfig;
}

const { backHref, accentColor, download } = Astro.props;
---

<div
  id="small-screen-overlay"
  role="dialog"
  aria-modal="true"
  aria-labelledby="small-screen-title"
>
  <Icon name="devices" size="3rem" />
  <h2 id="small-screen-title">Screen too small</h2>
  <p>
    This reader needs more space for a two-page spread. Open it on a larger
    device, or download the PDF to read offline.
  </p>
  <div id="small-screen-actions">
    {
      download && (
        <Button
          href={download.href}
          download={download.filename ?? true}
          color={accentColor}
          primary
        >
          <Icon name="download" />
          Download PDF
        </Button>
      )
    }
    {
      backHref && (
        <Button href={backHref} color={accentColor}>
          <Icon name="arrow_back" />
          Go back
        </Button>
      )
    }
  </div>
</div>
