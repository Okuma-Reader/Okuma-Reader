---
import Icon from "./Icon.astro";
import type { OkumaDownloadConfig } from "../types";

export interface ReaderToolbarProps {
  title: string;
  subtitle?: string;
  backHref?: string;
  download?: OkumaDownloadConfig;
}

const { title, subtitle, backHref, download } =
  Astro.props as ReaderToolbarProps;
---

<header>
  <div>
    {
      backHref ? (
        <a class="icon-button" href={backHref} aria-label="Go back" title="Go back">
          <Icon name="arrow_back" />
        </a>
      ) : null
    }
    <div>
      <h1>
        {title}
      </h1>
      {subtitle ? <p>{subtitle}</p> : null}
    </div>
  </div>

  <div>
    <label id="page-jump">
      <input
        type="text"
        data-page-input
        value="1"
        size="3"
        inputmode="numeric"
      />
      <span data-page-count>/</span>
    </label>
    <div id="zoom-controls">
      <button
        type="button"
        class="icon-button"
        aria-label="Zoom out"
        title="Zoom out"
        data-zoom-out
      >
        <Icon name="zoom_out" />
      </button>
      <button
        type="button"
        aria-label="Reset zoom"
        title="Reset zoom"
        class="icon-button"
        data-zoom-reset
      >
        <span data-zoom-label>100%</span>
      </button>
      <button
        type="button"
        aria-label="Zoom in"
        title="Zoom in"
        data-zoom-in
        class="icon-button"
      >
        <Icon name="zoom_in" />
      </button>
    </div>
  </div>

  <div>
    <button
      type="button"
      class="icon-button"
      id="shortcuts-open"
      aria-label="Keyboard shortcuts"
      title="Keyboard shortcuts"
      aria-controls="shortcuts-dialog"
      aria-expanded="false"
    >
      <Icon name="keyboard-command-key" />
    </button>

    <button
      type="button"
      class="icon-button"
      id="search-open"
      aria-label="Find in book"
      title="Find in book"
      aria-controls="reader-search"
      aria-expanded="false"
    >
      <Icon name="search" />
    </button>

    {
      download ? (
        <a
          href={download.href}
          class="icon-button"
          id="download-pdf"
          download={download.filename ?? true}
          aria-label="Download PDF"
          title="Download PDF"
        >
          <Icon name="download" />
        </a>
      ) : null
    }

    <button
      type="button"
      class="icon-button"
      id="fullscreen-enter"
      aria-label="Enter fullscreen"
      title="Enter fullscreen"
    >
      <Icon name="fullscreen" />
    </button>
  </div>
</header>

<style>
  header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    padding: clamp(12px, 2vw, 28px);
    padding-bottom: 0;

    @media (max-width: 648px) {
      gap: 0.75rem clamp(0.5rem, 1vw, 1rem);
      justify-content: center;
    }

    & > div {
      display: flex;
      gap: 0.75rem clamp(0.5rem, 1vw, 1rem);
      align-items: center;

      /* Go back and book title */
      &:nth-child(1) {
        color: var(--accent-color);

        & > a > :global(svg) {
          width: 30px;
          height: 30px;
        }

        & > div {
          & > h1 {
            margin: 0;
            font-size: 1.15rem;
            font-weight: 700;
            line-height: 1.2;
          }

          & > p {
            font-size: 0.9rem;
            margin: 0;
          }

          @media (max-width: 1400px) {
            display: none;
          }
        }
      }

      /* Navigation controls */
      &:nth-child(2) {
        & > #page-jump {
          box-sizing: border-box;
          height: 50px;
          padding: 0 0.8em;
          border: 3px solid var(--accent-color);
          background: white;
          color: var(--accent-color);
          font-weight: 600;
          display: flex;
          align-items: center;
          font-size: 1.3rem;

          & > input {
            border: 0;
            width: 3ch;
            text-align: right;
            background: transparent;
            color: inherit;
            font: inherit;
            font-weight: inherit;
            margin-right: 0.2em;
          }

          & > span {
            min-width: 4.2ch;
          }
        }

        & > #zoom-controls {
          box-sizing: border-box;
          display: flex;
          align-items: stretch;
          height: 50px;
          background: white;
          color: var(--accent-color);

          & > button {
            & ~ button {
              border-left: 0;
            }

            /* Reset zoom button */
            &:nth-child(2) {
              min-width: 4em;
              font-weight: 600;
              font-size: 1.3rem;
            }
          }
        }
      }
    }
  }

  .icon-button {
    box-sizing: border-box;
    width: 50px;
    height: 50px;
    border: 3px solid var(--accent-color);
    background: white;
    color: var(--accent-color);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;

    & :global(svg) {
      width: 28px;
      height: 28px;
    }

    &:disabled {
      cursor: not-allowed;
    }

    &:hover:not(:disabled),
    &:focus-visible:not(:disabled),
    &[aria-expanded="true"]:not(:disabled) {
      background: var(--accent-color);
      color: white;
    }
  }
</style>
