---
import Icon from "./Icon.astro";
import { okumaProgressStorageKey } from "@okuma-reader/core";
import type { OkumaDownloadConfig } from "../types";

interface Props {
  bookId: string;
  title: string;
  subtitle?: string;
  backHref?: string;
  download?: OkumaDownloadConfig;
}

const { bookId, title, subtitle, backHref, download } = Astro.props;
const progressKey = okumaProgressStorageKey(bookId);
---

<header>
  <div>
    {
      backHref ? (
        <a
          class="icon-button"
          href={backHref}
          aria-label="Go back"
          title="Go back"
        >
          <Icon name="arrow_back" />
        </a>
      ) : null
    }
    <div>
      <h1>
        {title}
      </h1>
      {subtitle ? <p>{subtitle}</p> : null}
    </div>
  </div>

  <div>
    <label id="page-jump">
      <input
        type="text"
        data-page-input
        data-okuma-progress-key={progressKey}
        value="1"
        size="3"
        inputmode="numeric"
        autocomplete="off"
      />
      <script is:inline>
        (() => {
          const input = document.currentScript?.previousElementSibling;
          if (!(input instanceof HTMLInputElement)) return;
          const key = input.dataset.okumaProgressKey;
          if (!key) return;
          try {
            const raw = localStorage.getItem(key);
            if (raw === null) return;
            const page = Number(raw);
            if (!Number.isFinite(page) || page < 1) return;
            input.value = String(Math.round(page));
          } catch {
            /* private mode / quota */
          }
        })();
      </script>
      <span data-page-count>/</span>
    </label>
    <div id="zoom-controls">
      <button
        type="button"
        class="icon-button"
        aria-label="Zoom out"
        title="Zoom out"
        data-zoom-out
      >
        <Icon name="zoom_out" />
      </button>
      <button
        type="button"
        aria-label="Reset zoom"
        title="Reset zoom"
        class="icon-button"
        data-zoom-reset
      >
        <span data-zoom-label>100%</span>
      </button>
      <button
        type="button"
        aria-label="Zoom in"
        title="Zoom in"
        data-zoom-in
        class="icon-button"
      >
        <Icon name="zoom_in" />
      </button>
    </div>
  </div>

  <div>
    <button
      type="button"
      class="icon-button"
      id="shortcuts-open"
      aria-label="Keyboard shortcuts"
      title="Keyboard shortcuts"
      aria-controls="shortcuts-dialog"
      aria-expanded="false"
    >
      <Icon name="keyboard-command-key" />
    </button>

    <button
      type="button"
      class="icon-button"
      id="search-open"
      aria-label="Find in book"
      title="Find in book"
      aria-controls="reader-search"
      aria-expanded="false"
    >
      <Icon name="search" />
    </button>

    {
      download ? (
        <a
          href={download.href}
          class="icon-button"
          id="download-pdf"
          download={download.filename ?? true}
          aria-label="Download PDF"
          title="Download PDF"
        >
          <Icon name="download" />
        </a>
      ) : null
    }

    <button
      type="button"
      class="icon-button"
      id="fullscreen-enter"
      aria-label="Enter fullscreen"
      title="Enter fullscreen"
    >
      <Icon name="fullscreen" />
    </button>
  </div>
</header>

