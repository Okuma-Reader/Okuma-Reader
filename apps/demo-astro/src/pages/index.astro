</html>

<style>
  body {
    margin: 0;
    box-sizing: border-box;
    min-height: 100dvh;
    font-family: system-ui, sans-serif;
    color: #1a1a1a;
    background: #f6f4f1;
    display: grid;
    place-items: center;
    padding: 2rem;
  }
  main {
    width: min(36rem, 100%);
  }
  .framework-icon {
    display: block;
    margin: 0 0 2rem;
    color: #1a1a1a;
  }
  h1 {
    margin: 0 0 0.35rem;
    font-size: 1.75rem;
    font-weight: 700;
  }
  .lede {
    margin: 0 0 1.75rem;
    color: #555;
    line-height: 1.45;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  a {
    display: block;
    padding: 1rem 1.15rem;
    color: inherit;
    text-decoration: none;
    background: white;
    border: 2px solid #1a1a1a;
  }
  a:hover,
  a:focus-visible {
    background: #1a1a1a;
    color: white;
  }
  a strong {
    display: block;
    font-size: 1.1rem;
  }
  a span {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.9rem;
    opacity: 0.75;
  }
</style>
