<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>okuma-reader demo</title>
  </head>
  <body>
    <main>
      <h1>Okuma-Reader Astro demo</h1>
      <p class="lede">Pick a demo source to open in the reader.</p>
      <ul>
        <li>
          <a href="/images">
            <strong>Images</strong>
            <span>Le Petit Prince — 108 images</span>
          </a>
        </li>
        <li>
          <a href="/pdf">
            <strong>PDF</strong>
            <span>NGE Genocide Vol. 1 — 328 pages PDF</span>
          </a>
        </li>
      </ul>
    </main>
  </body>
</html>

<style>
  body {
    margin: 0;
    min-height: 100dvh;
    font-family: system-ui, sans-serif;
    color: #1a1a1a;
    background: #f6f4f1;
    display: grid;
    place-items: center;
    padding: 2rem;
  }
  main {
    width: min(36rem, 100%);
  }
  h1 {
    margin: 0 0 0.35rem;
    font-size: 1.75rem;
    font-weight: 700;
  }
  .lede {
    margin: 0 0 1.75rem;
    color: #555;
    line-height: 1.45;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  a {
    display: block;
    padding: 1rem 1.15rem;
    color: inherit;
    text-decoration: none;
    background: white;
    border: 2px solid #1a1a1a;
  }
  a:hover,
  a:focus-visible {
    background: #1a1a1a;
    color: white;
  }
  a strong {
    display: block;
    font-size: 1.1rem;
  }
  a span {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.9rem;
    opacity: 0.75;
  }
</style>
