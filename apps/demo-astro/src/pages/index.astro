<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Okuma-Reader Astro demo</title>
    <link rel="icon" href="/favicon.webp" type="image/webp" />
  </head>
  <body>
    <main>
      <svg
        class="framework-icon"
        viewBox="0 0 24 24"
        width="64"
        height="64"
        aria-hidden="true"
        focusable="false"
      >
        <path
          fill="currentColor"
