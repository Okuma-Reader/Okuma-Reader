---
import { OkumaReader } from "@okuma-reader/astro";
import ReaderLayout from "../layouts/ReaderLayout.astro";
---

<ReaderLayout title="NGE Genocide Vol.1 (PDF) — okuma-reader demo">
  <OkumaReader
    bookId="nge-genocide-vol1"
    title="NGE Genocide"
    subtitle="Vol. 1 — PDF demo"
    innerCoverImageUrl="/fixtures/nge-genocide-vol1/inner-cover.png"
    accentColor="#694588"
    scrubberTrackColor="#DDCDE9"
    backHref="/"
    download={{
      href: "/fixtures/nge-genocide-vol1.pdf",
      filename: "nge-genocide-vol1.pdf",
    }}
    source={{
      type: "pdf",
      url: "/fixtures/nge-genocide-vol1.pdf",
    }}
  />
</ReaderLayout>
