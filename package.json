{
  "name": "okuma-reader",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @okuma-reader/core -w @okuma-reader/source-pdf -w @okuma-reader/source-images -w @okuma-reader/astro",
    "dev": "npm run dev -w @okuma-reader/demo",
    "check": "npm run check --workspaces --if-present",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix ."
  },
  "devDependencies": {
    "oxlint": "^1.81.0"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.25.12": true,
    "sharp@0.34.5": true
  }
}
